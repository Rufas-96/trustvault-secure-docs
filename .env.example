# Copy to your host's environment settings. None of these are needed for local dev:
# without DATABASE_URL the app uses embedded PGlite in .data/ and generates dev keys.

NODE_ENV=production
PORT=3000

# PostgreSQL 15+ connection string. TLS is verified unless it contains sslmode=disable.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep them stable: changing FILE_ENCRYPTION_KEY makes stored files unreadable,
# changing AUDIT_HMAC_KEY makes the existing audit chain fail verification.
FILE_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

# Set to false to skip creating demo users/documents in an empty database.
SEED_ON_BOOT=true
